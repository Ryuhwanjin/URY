#!/bin/bash
# =============================================================================
# 🎓 URY v0.9.6 — macOS 최초 실행 안내
# =============================================================================
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
cd "$DIR"

echo "======================================================"
echo "🚀 URY v0.9.6 macOS 최초 실행 안내"
echo "======================================================"

# 서명되지 않은 배포본은 사용자가 시스템 설정에서 직접 승인해야 합니다.
echo "1) 응용 프로그램에서 URY.app을 한 번 실행하세요."
echo "2) 차단 경고에서 [완료]를 누르세요."
echo "3) 지금 열리는 [개인정보 보호 및 보안]의 보안 항목에서"
echo "   URY 옆 [확인 없이 열기]를 누르세요."
open "x-apple.systempreferences:com.apple.preference.security?General"

exit 0
